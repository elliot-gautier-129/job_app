{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.3"
    },
    "bullet_variants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "achievement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "emphasis": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "skill_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "proposed",
              "approved",
              "rejected"
            ]
          },
          "source": {
            "enum": [
              "existing_cv",
              "user_written",
              "claude_generated",
              "agent_generated"
            ]
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "approved_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "approved_text_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "achievement_ids",
          "text",
          "emphasis",
          "skill_ids",
          "status",
          "source",
          "priority",
          "approved_at",
          "approved_text_sha256"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "approved"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "approved_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "approved_text_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            "else": {
              "properties": {
                "approved_at": {
                  "type": "null"
                },
                "approved_text_sha256": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "bullet_variants"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/job-agent/schema/v1.3/bullet_variants.schema.json",
  "title": "Job Agent bullet_variants v1.3"
}
