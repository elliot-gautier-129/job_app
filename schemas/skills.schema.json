{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.3"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "programming",
              "machine_learning",
              "data_engineering",
              "cloud",
              "statistics",
              "tools",
              "domain",
              "other",
              "spoken_language"
            ]
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "evidence_achievement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "uniqueItems": true
          },
          "cv_eligible": {
            "type": "boolean"
          },
          "proficiency": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "description": "Spoken-language proficiency, null for technical skills."
          },
          "confirmation_status": {
            "enum": [
              "confirmed",
              "unconfirmed"
            ],
            "description": "confirmed = user has explicitly verified they have the skill; unconfirmed = suggested (e.g. from a job description), awaiting review. Independent of evidence_achievement_ids. Internal metadata: never rendered."
          }
        },
        "required": [
          "id",
          "name",
          "category",
          "aliases",
          "evidence_achievement_ids",
          "cv_eligible",
          "proficiency",
          "confirmation_status"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "category": {
                  "const": "spoken_language"
                }
              },
              "required": [
                "category"
              ]
            },
            "then": {
              "properties": {
                "proficiency": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "skills"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/job-agent/schema/v1.3/skills.schema.json",
  "title": "Job Agent skills v1.3"
}
