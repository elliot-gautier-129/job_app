{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.3"
    },
    "full_name": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "contact": {
      "type": "object",
      "properties": {
        "email": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "linkedin": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "github": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "website": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "email",
        "linkedin",
        "github",
        "website"
      ],
      "additionalProperties": false
    },
    "contact_profiles": {
      "type": "object",
      "properties": {
        "US": {
          "type": "object",
          "properties": {
            "location": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "phone": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "work_authorization_display": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Exact header text shown on CVs using this contact profile (e.g. 'Eligible for OPT + STEM OPT'). null = no authorization line."
            }
          },
          "required": [
            "location",
            "phone",
            "work_authorization_display"
          ],
          "additionalProperties": false
        },
        "UK": {
          "type": "object",
          "properties": {
            "location": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "phone": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "work_authorization_display": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Exact header text shown on CVs using this contact profile (e.g. 'Eligible for OPT + STEM OPT'). null = no authorization line."
            }
          },
          "required": [
            "location",
            "phone",
            "work_authorization_display"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "US",
        "UK"
      ],
      "additionalProperties": false
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "cv_eligible": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "detail",
          "cv_eligible"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "full_name",
    "contact",
    "contact_profiles",
    "interests"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/job-agent/schema/v1.3/profile.schema.json",
  "title": "Job Agent profile v1.3"
}
