{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.3"
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "institution": {
            "type": "string",
            "minLength": 1
          },
          "degree": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "start_date": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{4}(?:-(?:0[1-9]|1[0-2])(?:-(?:0[1-9]|[12][0-9]|3[01]))?)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "end_date": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{4}(?:-(?:0[1-9]|1[0-2])(?:-(?:0[1-9]|[12][0-9]|3[01]))?)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "expected_completion": {
            "type": "boolean"
          },
          "grade": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "coursework": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "anyOf": [
                    {
                      "enum": [
                        "completed",
                        "in_progress",
                        "planned"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Completion status of a named course. null = not tracked, used for topic-level coursework entries that are not official course titles; the renderer must never imply completion for null."
                },
                "grade": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "verified": {
                  "type": "boolean"
                },
                "annotation": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "id",
                "name",
                "status",
                "grade",
                "verified",
                "annotation"
              ],
              "additionalProperties": false
            },
            "uniqueItems": true
          },
          "honors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "cv_eligible": {
            "type": "boolean"
          },
          "date_display": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional exact CV date display, derived from verified dates; never invent precision. A null end_date does not imply ongoing."
          }
        },
        "required": [
          "id",
          "institution",
          "degree",
          "field",
          "location",
          "start_date",
          "end_date",
          "expected_completion",
          "grade",
          "coursework",
          "honors",
          "cv_eligible",
          "date_display"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "education"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/job-agent/schema/v1.3/education.schema.json",
  "title": "Job Agent education v1.3"
}
